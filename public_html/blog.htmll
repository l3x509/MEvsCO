<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Blog — Me vs. Collector | FDCPA Rights, Guides & Strategies</title>
<meta name="description" content="Plain-English guides on FDCPA rights, common debt collector violations, how to fight back, and how free FDCPA lawsuits work. Written for the 77 million Americans in debt collections.">

<!-- Open Graph — Facebook, LinkedIn, iMessage, WhatsApp -->
<meta property="og:type"         content="website" />
<meta property="og:url"          content="https://mevscollector.com/blog.html" />
<meta property="og:title"        content="Me vs. Collector — The Blog" />
<meta property="og:description"  content="Free FDCPA guides for the 77 million Americans in debt collections. Plain English, no lawyer needed." />
<meta property="og:image"        content="https://mevscollector.com/og-image-final.png" />
<meta property="og:image:width"  content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter / X -->
<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:url"         content="https://mevscollector.com/blog.html" />
<meta name="twitter:title"       content="Me vs. Collector — The Blog" />
<meta name="twitter:description" content="Free FDCPA guides for the 77 million Americans in debt collections. Plain English, no lawyer needed." />
<meta name="twitter:image"       content="https://mevscollector.com/og-image-final.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --ink: #0d0d0d;
    --page: #f5f2ec;
    --paper: #fffdf8;
    --amber: #d4870a;
    --amber-light: #f5a623;
    --amber-pale: #fef3dc;
    --red: #c0392b;
    --red-pale: #fdecea;
    --green: #1a6b3c;
    --green-pale: #e6f4ed;
    --charcoal: #1a1a1a;
    --muted: #6b6b6b;
    --border: #e0dbd0;
    --rule: #d0ccc0;
    --serif: 'Playfair Display', Georgia, serif;
    --sans: 'DM Sans', system-ui, sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--sans);
    background: var(--page);
    color: var(--ink);
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: var(--charcoal);
    border-bottom: 2px solid var(--amber);
    padding: 0 2rem;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
    letter-spacing: -0.5px;
  }

  .nav-logo span { color: var(--amber-light); }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  .nav-links a {
    color: #ccc;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .nav-links a:hover, .nav-links a.active { color: var(--amber-light); }

  .nav-cta {
    background: var(--amber);
    color: #fff !important;
    padding: 0.5rem 1.25rem;
    border-radius: 3px;
  }

  @media (max-width: 700px) { .nav-links { display: none; } }

  /* ── BLOG HEADER ── */
  .blog-header {
    background: var(--charcoal);
    padding: 100px 2rem 60px;
    color: #fff;
    border-bottom: 2px solid var(--amber);
  }

  .blog-header-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .header-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--amber-light);
    margin-bottom: 1rem;
  }

  .blog-header h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -1px;
    margin-bottom: 0.75rem;
  }

  .blog-header p {
    color: #999;
    font-size: 1rem;
    max-width: 520px;
    font-weight: 300;
    line-height: 1.65;
  }

  /* ── FILTER TABS ── */
  .filter-bar {
    background: var(--paper);
    border-bottom: 1px solid var(--border);
    padding: 0 2rem;
    display: flex;
    gap: 0;
    overflow-x: auto;
    max-width: 100%;
  }

  .filter-tab {
    padding: 1rem 1.25rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    transition: color 0.2s, border-color 0.2s;
    background: none;
    border-top: none;
    border-left: none;
    border-right: none;
    font-family: var(--sans);
  }

  .filter-tab:hover { color: var(--ink); }
  .filter-tab.active { color: var(--amber); border-bottom-color: var(--amber); }

  /* ── MAIN LAYOUT ── */
  .blog-layout {
    max-width: 960px;
    margin: 0 auto;
    padding: 3rem 2rem 5rem;
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 750px) {
    .blog-layout { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  /* ── FEATURED POST ── */
  .featured-post {
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 2rem;
    border-top: 4px solid var(--amber);
    text-decoration: none;
    color: var(--ink);
    display: block;
    transition: transform 0.15s;
  }

  .featured-post:hover { transform: translateY(-2px); }

  .featured-inner {
    padding: 2rem;
  }

  .featured-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .featured-label::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
  }

  .featured-title {
    font-family: var(--serif);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.3px;
    margin-bottom: 0.75rem;
    color: var(--ink);
  }

  .featured-desc {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .meta-tag {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 2px;
    background: var(--red-pale);
    color: var(--red);
  }

  .read-link {
    color: var(--amber);
    font-weight: 600;
    font-size: 0.85rem;
    margin-left: auto;
  }

  /* ── POST LIST ── */
  .section-divider {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-item {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
    align-items: flex-start;
    transition: background 0.1s;
  }

  .post-item:last-child { border-bottom: none; }
  .post-item:hover .post-item-title { color: var(--amber); }

  .post-item-num {
    font-family: var(--serif);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--border);
    line-height: 1;
    width: 36px;
    flex-shrink: 0;
    padding-top: 2px;
  }

  .post-item-body { flex: 1; }

  .post-item-tag {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 0.3rem;
    display: block;
  }

  .post-item-tag.red { color: var(--red); }
  .post-item-tag.green { color: var(--green); }

  .post-item-title {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.3rem;
    transition: color 0.2s;
  }

  .post-item-desc {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.55;
    margin-bottom: 0.4rem;
  }

  .post-item-meta {
    font-size: 0.75rem;
    color: #bbb;
  }

  /* ── SIDEBAR ── */
  .sidebar {
    position: sticky;
    top: 80px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sidebar-card {
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1.5rem;
  }

  .sidebar-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .sidebar-checker {
    background: var(--charcoal);
    color: #fff;
    border-radius: 4px;
    padding: 1.75rem;
  }

  .sidebar-checker .sidebar-label { color: var(--amber-light); border-bottom-color: rgba(255,255,255,0.1); }

  .checker-prompt {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .checker-sub {
    font-size: 0.85rem;
    color: #888;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .checker-btn {
    display: block;
    background: var(--amber);
    color: #fff;
    text-align: center;
    padding: 0.85rem 1rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    transition: background 0.2s;
  }

  .checker-btn:hover { background: var(--amber-light); }

  .checker-note {
    text-align: center;
    font-size: 0.75rem;
    color: #666;
    margin-top: 0.6rem;
  }

  .topics-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .topic-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
    font-size: 0.88rem;
    transition: color 0.2s;
  }

  .topic-item:last-child { border-bottom: none; }
  .topic-item:hover { color: var(--amber); }

  .topic-count {
    font-size: 0.75rem;
    color: var(--muted);
    background: var(--page);
    padding: 0.15rem 0.5rem;
    border-radius: 10px;
  }

  .email-sidebar-form {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .sidebar-input {
    padding: 0.75rem 1rem;
    background: var(--page);
    border: 1px solid var(--border);
    border-radius: 3px;
    font-family: var(--sans);
    font-size: 0.9rem;
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s;
  }

  .sidebar-input:focus { border-color: var(--amber); }

  .sidebar-submit {
    background: var(--amber);
    border: none;
    color: #fff;
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.75rem;
    border-radius: 3px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .sidebar-submit:hover { background: var(--amber-light); }

  .sidebar-guarantee {
    font-size: 0.73rem;
    color: var(--muted);
    text-align: center;
  }

  /* Footer */
  footer {
    background: #111;
    color: #888;
    padding: 2.5rem 2rem;
  }

  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-brand {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
  }

  .footer-brand span { color: var(--amber-light); }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    flex-wrap: wrap;
  }

  .footer-links a {
    color: #777;
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.2s;
  }

  .footer-links a:hover { color: var(--amber-light); }

  .footer-copy {
    width: 100%;
    font-size: 0.75rem;
    color: #444;
    padding-top: 1.25rem;
    border-top: 1px solid #222;
    margin-top: 0.5rem;
  }

  /* ── SHARE BUTTON ── */
  .share-wrap {
    position: relative;
    display: inline-block;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.73rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 3px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .share-btn:hover { border-color: var(--amber); color: var(--amber); }

  .share-btn svg { width: 13px; height: 13px; flex-shrink: 0; }

  .share-dropdown {
    display: none;
    position: absolute;
    bottom: calc(100% + 6px);
    left: 0;
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 5px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.12);
    min-width: 170px;
    z-index: 200;
    overflow: hidden;
  }

  .share-dropdown.open { display: block; }

  .share-dropdown-title {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0.6rem 0.85rem 0.4rem;
    border-bottom: 1px solid var(--rule);
  }

  .share-option {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.85rem;
    font-size: 0.83rem;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
    text-decoration: none;
    border: none;
    background: none;
    font-family: var(--sans);
    width: 100%;
    transition: background 0.15s, color 0.15s;
  }

  .share-option:hover { background: var(--amber-pale); color: var(--amber); }

  .share-option svg { width: 15px; height: 15px; flex-shrink: 0; }

  .share-option.copied { color: var(--green); }

  /* Featured post share row */
  .featured-share-row {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--rule);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .share-label-text {
    font-size: 0.72rem;
    color: var(--muted);
    font-weight: 500;
    letter-spacing: 0.3px;
  }

  /* Post item share row */
  .post-share-row {
    margin-top: 0.55rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
</head>
